{
  "manifest_version": 3,
  "name": "Lens",
  "version": "0.1.0",
  "description": "Ask questions about whatever webpage you're looking at.",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage", "contextMenus"],
  "action": {
    "default_title": "Open Lens"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}